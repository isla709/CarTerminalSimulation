<Window x:Class="TerminalSimulation.Updater.UpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用更新 · 车载定位终端模拟系统" Width="720" Height="560"
        Icon="pack://application:,,,/update;component/Assets/update-icon.ico"
        MinWidth="640" MinHeight="520" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Closing="Window_Closing"
        ResizeMode="CanMinimize" Background="#F5F7FC" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#E9EDF6"/>
            <Setter Property="Foreground" Value="#46536D"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#3478F6"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="#3478F6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#E9EFF9" CornerRadius="5">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5" Background="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Background" Value="#E9EDF6"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="LayoutRoot" Margin="30" Background="#F5F7FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="IconSurface" Width="64" Height="64" CornerRadius="20" Margin="0,0,18,0">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2D93FF"/><GradientStop Color="#625CF1" Offset="1"/></LinearGradientBrush></Border.Background>
                <Grid>
                <Grid x:Name="UpdateIcon" Width="44" Height="44">
                    <Grid x:Name="UpdateRing" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><RotateTransform x:Name="RingRotation"/></Grid.RenderTransform>
                        <Path Data="M 34,10 A 17,17 0 1 0 39,22" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M 34,3 L 34,10 L 27,10" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                    <Path x:Name="UpdateArrow" Data="M 22,32 L 22,15 M 15.5,21.5 L 22,15 L 28.5,21.5" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Grid>
                <Path x:Name="SuccessMark" Visibility="Collapsed" Data="M 1,12 L 10,21 L 27,3" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="30" Height="26" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><ScaleTransform x:Name="SuccessScale"/></Path.RenderTransform>
                </Path>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="更新与版本切换" FontSize="25" FontWeight="SemiBold" Foreground="#18243D"/>
                <TextBlock x:Name="VersionText" Text="正在准备安全更新" Margin="0,7,0,0" FontSize="12" Foreground="#728099" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,26,0,20">
            <Border x:Name="DownloadStep" Style="{StaticResource Step}"><TextBlock Text="01  下载" HorizontalAlignment="Center" Foreground="#65738C" FontSize="12"/></Border>
            <Border x:Name="VerifyStep" Style="{StaticResource Step}"><TextBlock Text="02  校验" HorizontalAlignment="Center" Foreground="#65738C" FontSize="12"/></Border>
            <Border x:Name="RuntimeStep" Style="{StaticResource Step}"><TextBlock Text="03  适配" HorizontalAlignment="Center" Foreground="#65738C" FontSize="12"/></Border>
            <Border x:Name="InstallStep" Style="{StaticResource Step}"><TextBlock Text="04  安装" HorizontalAlignment="Center" Foreground="#65738C" FontSize="12"/></Border>
            <Border x:Name="StartStep" Style="{StaticResource Step}" Margin="0"><TextBlock Text="05  启动" HorizontalAlignment="Center" Foreground="#65738C" FontSize="12"/></Border>
        </UniformGrid>
        <Border Grid.Row="2" Background="White" CornerRadius="20" BorderBrush="#E3E9F4" BorderThickness="1" Padding="24">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel x:Name="PhaseContent" VerticalAlignment="Center">
                        <StackPanel.RenderTransform><TranslateTransform x:Name="PhaseTranslation"/></StackPanel.RenderTransform>
                        <TextBlock x:Name="PhaseTitle" Text="一切就绪，即将开始" FontSize="20" FontWeight="SemiBold" Foreground="#202D47"/>
                    </StackPanel>
                    <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontSize="30" FontWeight="SemiBold" Foreground="#3478F6" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
                <ProgressBar x:Name="ProgressBar" Grid.Row="1" Height="9" Minimum="0" Maximum="100" Margin="0,24,0,18"/>
                <ScrollViewer x:Name="StatusScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="StatusText" Text="更新过程不会更改您的配置与工作区。" Foreground="#64718A" FontSize="13" LineHeight="23" TextWrapping="Wrap" Padding="0,0,6,8"/>
                </ScrollViewer>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,22,0,0">
            <Button x:Name="CloseButton" HorizontalAlignment="Right" Content="取消更新" Click="CloseButton_Click" MinWidth="112" MinHeight="40"/>
        </Grid>
    </Grid>
</Window>
