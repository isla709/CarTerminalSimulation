<Window x:Class="TerminalSimulation.Updater.InstallerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="安装 · 车载定位终端模拟系统" Width="720" Height="590" MinWidth="620" MinHeight="540"
 WindowStartupLocation="CenterScreen" Background="#F5F7FC" FontFamily="Microsoft YaHei UI" ResizeMode="CanMinimize"
 Icon="pack://application:,,,/update;component/Assets/setup-icon.ico" Closing="OnClosing" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#E8EEF9"/><Setter Property="Foreground" Value="#405474"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="20,12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value=".8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,24,8"/><Setter Property="Foreground" Value="#536783"/><Setter Property="FontSize" Value="13"/></Style>
 </Window.Resources>
 <Grid x:Name="LayoutRoot" Margin="30">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,2,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Image Width="60" Height="60" Source="pack://application:,,,/update;component/Assets/setup-icon.png" Stretch="Uniform" HorizontalAlignment="Left"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="Heading" Text="安装车载定位终端模拟系统" FontSize="24" FontWeight="Bold" Foreground="#18273F"/><TextBlock x:Name="VersionText" FontSize="12" Foreground="#7D8FAB" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" CornerRadius="20" Background="White" BorderBrush="#E0E8F5" BorderThickness="1" Padding="24">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock x:Name="ActionTitle" Text="选择安装位置" FontWeight="SemiBold" FontSize="19" Foreground="#253953"/>
    <Grid x:Name="DirectoryPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DirectoryInput" FontSize="13" Padding="10" VerticalContentAlignment="Center" BorderBrush="#D5E0EF"/><Button Grid.Column="1" Content="浏览…" Click="Browse" Margin="10,0,0,0"/></Grid>
    <WrapPanel x:Name="Shortcuts" Margin="0,12,0,0"><CheckBox x:Name="StartMenu" Content="创建开始菜单快捷方式" IsChecked="True"/><CheckBox x:Name="Desktop" Content="创建桌面快捷方式"/></WrapPanel>
    <TextBlock x:Name="DataNotice" Text="覆盖安装会保留配置、插件和工作区。" Foreground="#7187A6" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/>
    <ProgressBar x:Name="Progress" Height="8" Margin="0,24,0,14" Foreground="#3478F6" Background="#E9EFF9" BorderThickness="0" Visibility="Collapsed"/>
    <TextBlock x:Name="Status" FontSize="13" Foreground="#526B8D" TextWrapping="Wrap" Margin="0,14,0,0"/>
   </StackPanel></ScrollViewer>
  </Border>
  <Grid Grid.Row="2" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="CancelButton" Grid.Column="1" Content="取消" Click="Cancel" Margin="0,0,10,0"/>
   <Button x:Name="InstallButton" Grid.Column="2" Content="开始安装" Background="#3478F6" Foreground="White" Click="Install"/>
  </Grid>
 </Grid>
</Window>
