# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local build-generated encrypted credentials; never generate into source.
/assets/credentials/*.bin

# Builder-owned signing material and local configuration.
*.p12
*.p7b
*.cer
*.csr
*.pem
*.key
*.jks
*.keystore
key.properties
local.properties
.env.*
!.env.example

# Native dependency and build caches (all platform modules).
**/.hvigor/
**/oh_modules/
**/.cxx/
**/.gradle/
