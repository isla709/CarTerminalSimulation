# Keep source and Unix entry points portable with core.autocrlf enabled.
* text=auto
*.dart text eol=lf
*.ts text eol=lf
*.ets text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.bin binary
*.hap binary
*.apk binary
