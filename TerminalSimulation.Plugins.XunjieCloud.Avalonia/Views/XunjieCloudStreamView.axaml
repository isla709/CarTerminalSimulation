<UserControl x:Class="TerminalSimulation.Plugins.XunjieCloud.Avalonia.Views.XunjieCloudStreamView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             xmlns:vm="using:TerminalSimulation.Plugins.XunjieCloud.Avalonia.ViewModels"
             xmlns:helpers="using:TerminalSimulation.Plugins.XunjieCloud.Avalonia.Helpers"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:XunjieCloudStreamViewModel">
    <Grid ColumnDefinitions="2*,1*" Margin="8">
        <!-- 左侧视频区域 -->
        <suki:GlassCard Grid.Column="0" Margin="0,0,8,0">
            <Grid>
                <!-- 防闪烁底衬 -->
                <Grid Background="#151515" IsVisible="{Binding !IsVideoViewVisible}">
                    <TextBlock Text="📹" FontSize="32" Foreground="#444" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               IsVisible="{Binding IsPlaying}" />
                </Grid>

                <vlc:VideoView MediaPlayer="{Binding MediaPlayer}" IsVisible="{Binding IsVideoViewVisible}" />
                
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsPlaying}">
                    <TextBlock Text="🚫" FontSize="64" Foreground="#888888" HorizontalAlignment="Center" />
                    <TextBlock Text="尚未拉取视频流" Foreground="#888888" Margin="0,16,0,0" FontSize="16" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </suki:GlassCard>

        <!-- 右侧控制与日志区域 -->
        <suki:GlassCard Grid.Column="1" Margin="0">
            <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*">
                <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="流媒体拉取配置" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="退出登录" Command="{Binding LogoutCommand}" Foreground="Red"
                            IsVisible="{Binding IsLoggedIn}" />
                </Grid>

                <!-- 登录板块 -->
                <StackPanel Grid.Row="1" IsVisible="{Binding !IsLoggedIn}">
                    <ComboBox PlaceholderText="账号 (Username)" 
                              SelectedItem="{Binding SelectedUsername}" 
                              ItemsSource="{Binding SavedUsernames}"
                              Margin="0,0,0,16" HorizontalAlignment="Stretch" />
                    <TextBox Watermark="密码 (Password)" 
                             PasswordChar="●"
                             Text="{Binding Password}" 
                             Margin="0,0,0,24" HorizontalAlignment="Stretch" />
                    <Button Content="登录平台" Command="{Binding LoginCommand}" Margin="0,0,0,16" HorizontalAlignment="Stretch" Classes="Primary" />
                </StackPanel>

                <!-- 配置项 (已登录状态) -->
                <StackPanel Grid.Row="1" IsVisible="{Binding IsLoggedIn}">
                    <Grid Margin="0,0,0,16" ColumnDefinitions="*,8,Auto">
                        <TextBox Grid.Column="0" Watermark="设备号 (Device No)" 
                                 Text="{Binding DeviceNo}" />
                        <Button Grid.Column="2" Content="获取通道" Command="{Binding FetchChannelsCommand}" Classes="Primary" />
                    </Grid>

                    <Grid Margin="0,0,0,24" ColumnDefinitions="*,8,*">
                        <ComboBox Grid.Column="0" PlaceholderText="选择通道 (Channel)" 
                                  ItemsSource="{Binding AvailableChannels}"
                                  SelectedItem="{Binding SelectedChannel}" HorizontalAlignment="Stretch" />
                        
                        <ComboBox Grid.Column="2" PlaceholderText="数据类型 (Data Type)" 
                                  ItemsSource="{Binding DataTypes}"
                                  SelectedItem="{Binding SelectedDataType}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:StreamDataType">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- 操作按钮 -->
                    <Grid Margin="0,0,0,16" ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto">
                        <Button Grid.Row="0" Grid.Column="0" Content="开启通道" Command="{Binding OpenChannelCommand}" HorizontalAlignment="Stretch" Classes="Primary" />
                        <Button Grid.Row="0" Grid.Column="2" Content="关闭通道" Command="{Binding CloseChannelCommand}" HorizontalAlignment="Stretch" Classes="Basic" />
                        
                        <Button Grid.Row="2" Grid.Column="0" Content="开始拉取" Command="{Binding StartPlayCommand}" 
                                HorizontalAlignment="Stretch" Classes="Primary"
                                IsEnabled="{Binding !IsPlaying}" />
                        <Button Grid.Row="2" Grid.Column="2" Content="结束拉取" Command="{Binding StopPlayCommand}" 
                                HorizontalAlignment="Stretch" Classes="Basic"
                                IsEnabled="{Binding IsPlaying}" />
                    </Grid>
                </StackPanel>

                <!-- 状态与日志 -->
                <Grid Grid.Row="3" RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="状态: " FontWeight="Bold" />
                            <TextBlock Text="{Binding StatusText}" Foreground="Blue" Margin="0,0,16,0" />
                            
                            <TextBlock Text="码率: " FontWeight="Bold" />
                            <TextBlock Text="{Binding CurrentBitrate}" Foreground="Green" Margin="0,0,16,0" />

                            <TextBlock Text="音频: " FontWeight="Bold" />
                            <TextBlock Text="{Binding HasAudioTrack}" Foreground="Orange" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔊" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" Width="150" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding NetworkLogs}" 
                              AutoGenerateColumns="False" IsReadOnly="True" 
                              Background="Transparent"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" FontFamily="Consolas" FontSize="11" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" FontWeight="Bold" FontSize="11" />
                            <DataGridTextColumn Header="请求/日志详情" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </suki:GlassCard>
    </Grid>
</UserControl>
