<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TerminalSimulation.Protocol\TerminalSimulation.Protocol.csproj" />
    <ProjectReference Include="..\TerminalSimulation.Network\TerminalSimulation.Network.csproj" />
    <ProjectReference Include="..\TerminalSimulation.PluginBase\TerminalSimulation.PluginBase.csproj" />
    <ProjectReference Include="..\TerminalSimulation.Updater\TerminalSimulation.Updater.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
    <ProjectReference Include="..\TerminalSimulation.Plugins.XunjieCloud\TerminalSimulation.Plugins.XunjieCloud.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.7.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" ExcludeAssets="build" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="splash_1.jpg" />
    <Resource Include="splash_2.jpg" />
    <Resource Include="splash_3.jpg" />
    <Resource Include="splash_dream_pool.png" />
    <Resource Include="splash_pool_sunlight.png" />
    <Resource Include="splash_pool_tyndall.png" />
    <Resource Include="splash_liminal_office.png" />
    <Resource Include="splash_flooded_concourse.png" />
    <Resource Include="splash_weirdcore_playhall.png" />
    <Resource Include="splash_starlit_hotel.png" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 手动修改程序版本号 -->
    <AppVersion>preview7</AppVersion>
    <UpdateChannel>preview</UpdateChannel>
    <!-- 更新版本线和不可逆兼容级别。不同版本线之间禁止互相更新。 -->
    <UpdateLine>main</UpdateLine>
    <CompatibilityEpoch>1</CompatibilityEpoch>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- The application currently ships a single neutral UI and does not load satellite localizations. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Themes\**\*" />
    <!-- Keep the generated version source visible to WPF's temporary markup project. -->
    <Compile Include="$(IntermediateOutputPath)AppVersionInfo.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Regions.json" />
    <None Remove="Regions.json" />
    <Content Include="Regions.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\update-sources.example.json" Link="update-sources.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="BuildNativeFfmpegBridge" BeforeTargets="PrepareForBuild"
          Condition="'$(OS)' == 'Windows_NT' and Exists('..\ThirdParty\ffmpeg\include\libavcodec\avcodec.h')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\FFmpeg.Native\build-win-x64.ps1&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)\.." />
  </Target>
  <Target Name="CopyNativeFfmpegRuntime" AfterTargets="Build" DependsOnTargets="BuildNativeFfmpegBridge">
    <ItemGroup>
      <NativeFfmpegRuntime Include="$(MSBuildProjectDirectory)\..\FFmpeg.Native\artifacts\win-x64\*.dll" />
      <NativeFfmpegRuntime Include="$(MSBuildProjectDirectory)\..\FFmpeg.Native\artifacts\win-x64\FFmpeg-GPL-LICENSE.txt" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)ffmpeg-native" />
    <Copy SourceFiles="@(NativeFfmpegRuntime)" DestinationFolder="$(TargetDir)ffmpeg-native" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyUpdaterRuntime" AfterTargets="Build">
    <ItemGroup>
      <UpdaterRuntime Include="$(MSBuildProjectDirectory)\..\TerminalSimulation.Updater\bin\$(Configuration)\net8.0-windows\update.exe" />
      <UpdaterRuntime Include="$(MSBuildProjectDirectory)\..\TerminalSimulation.Updater\bin\$(Configuration)\net8.0-windows\update.dll" />
      <UpdaterRuntime Include="$(MSBuildProjectDirectory)\..\TerminalSimulation.Updater\bin\$(Configuration)\net8.0-windows\update.deps.json" />
      <UpdaterRuntime Include="$(MSBuildProjectDirectory)\..\TerminalSimulation.Updater\bin\$(Configuration)\net8.0-windows\update.runtimeconfig.json" />
    </ItemGroup>
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\TerminalSimulation.Updater\bin\$(Configuration)\net8.0-windows\update.exe')"
           Text="更新程序未生成：update.exe" />
    <Copy SourceFiles="@(UpdaterRuntime)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="RemoveUnusedCultureDirectories" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <UnusedCultureDirectory Include="$(TargetDir)cs;$(TargetDir)de;$(TargetDir)es;$(TargetDir)fr;$(TargetDir)it;$(TargetDir)ja;$(TargetDir)ko;$(TargetDir)pl;$(TargetDir)pt-BR;$(TargetDir)ru;$(TargetDir)tr;$(TargetDir)zh-Hans;$(TargetDir)zh-Hant" />
    </ItemGroup>
    <RemoveDir Directories="@(UnusedCultureDirectory)" />
  </Target>
  <Target Name="AddExternalRuntimeFilesToPublish"
          BeforeTargets="ComputeFilesToPublish"
          DependsOnTargets="BuildNativeFfmpegBridge">
    <ItemGroup>
      <PublishNativeFfmpegRuntime Include="$(MSBuildProjectDirectory)\..\FFmpeg.Native\artifacts\win-x64\*.dll" />
      <PublishNativeFfmpegRuntime Include="$(MSBuildProjectDirectory)\..\FFmpeg.Native\artifacts\win-x64\FFmpeg-GPL-LICENSE.txt" />
      <ResolvedFileToPublish Include="@(PublishNativeFfmpegRuntime)">
        <RelativePath>ffmpeg-native\%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\TerminalSimulation.Plugins.XunjieCloud\bin\$(Configuration)\net8.0-windows\TerminalSimulation.Plugins.XunjieCloud.dll">
        <RelativePath>Plugins\TerminalSimulation.Plugins.XunjieCloud.Plugin</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\TerminalSimulation.Updater\bin\$(Configuration)\net8.0-windows\update.exe">
        <RelativePath>update.exe</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\TerminalSimulation.Updater\bin\$(Configuration)\net8.0-windows\update.dll">
        <RelativePath>update.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\TerminalSimulation.Updater\bin\$(Configuration)\net8.0-windows\update.deps.json">
        <RelativePath>update.deps.json</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\TerminalSimulation.Updater\bin\$(Configuration)\net8.0-windows\update.runtimeconfig.json">
        <RelativePath>update.runtimeconfig.json</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="GenerateBuildVersion" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <BuildDate>$([System.DateTime]::Now.ToString("yyyyMMdd"))</BuildDate>
      <RandomNum>$([System.Guid]::NewGuid().ToString().Substring(0, 4))</RandomNum>
      <RandomBuildString Condition="'$(BuildVersionOverride)' == ''">build.$(BuildDate).$(RandomNum)</RandomBuildString>
      <RandomBuildString Condition="'$(BuildVersionOverride)' != ''">$(BuildVersionOverride)</RandomBuildString>
      <VersionFileContent>
// &lt;auto-generated/&gt;
namespace TerminalSimulation.Wpf%3B
public static class AppVersionInfo
{
    public const string AppVersion = "$(AppVersion)"%3B
    public const string BuildVersion = "$(RandomBuildString)"%3B
    public const string FullVersion = AppVersion + "-" + BuildVersion%3B
    public const string UpdateLine = "$(UpdateLine)"%3B
    public const string UpdateChannel = "$(UpdateChannel)"%3B
    public const int CompatibilityEpoch = $(CompatibilityEpoch)%3B
}
      </VersionFileContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)AppVersionInfo.g.cs" Lines="$(VersionFileContent)" Overwrite="true" WriteOnlyWhenDifferent="false" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)libvlc.zip">
      <LogicalName>libvlc.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="EmbedLibVLC" BeforeTargets="BeforeResGen;PrepareForBuild">
    <PropertyGroup>
      <LibVlcSourceDir>$(PkgVideoLAN_LibVLC_Windows)\build\x64</LibVlcSourceDir>
      <LibVlcZipPath>$(IntermediateOutputPath)libvlc.zip</LibVlcZipPath>
    </PropertyGroup>
    <!-- 动态压缩 LibVLC 的原生库并作为内嵌资源嵌入 -->
    <ZipDirectory SourceDirectory="$(LibVlcSourceDir)" DestinationFile="$(LibVlcZipPath)" Overwrite="true" Condition="Exists('$(LibVlcSourceDir)')" />
  </Target>

</Project>
