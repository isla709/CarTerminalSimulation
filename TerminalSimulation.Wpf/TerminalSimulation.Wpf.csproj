<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TerminalSimulation.Protocol\TerminalSimulation.Protocol.csproj" />
    <ProjectReference Include="..\TerminalSimulation.Network\TerminalSimulation.Network.csproj" />
    <ProjectReference Include="..\TerminalSimulation.PluginBase\TerminalSimulation.PluginBase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.7.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" ExcludeAssets="build" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="splash_1.jpg" />
    <Resource Include="splash_2.jpg" />
    <Resource Include="splash_3.jpg" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 手动修改程序版本号 -->
    <AppVersion>preview4</AppVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Themes\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Regions.json" />
    <None Remove="Regions.json" />
    <Content Include="Regions.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="BuildNativeFfmpegBridge" BeforeTargets="PrepareForBuild"
          Condition="'$(OS)' == 'Windows_NT' and Exists('..\ThirdParty\ffmpeg\include\libavcodec\avcodec.h')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\FFmpeg.Native\build-win-x64.ps1&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)\.." />
  </Target>
  <Target Name="CopyNativeFfmpegRuntime" AfterTargets="Build" DependsOnTargets="BuildNativeFfmpegBridge">
    <ItemGroup>
      <NativeFfmpegRuntime Include="$(MSBuildProjectDirectory)\..\FFmpeg.Native\artifacts\win-x64\*.dll" />
      <NativeFfmpegRuntime Include="$(MSBuildProjectDirectory)\..\FFmpeg.Native\artifacts\win-x64\FFmpeg-GPL-LICENSE.txt" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)ffmpeg-native" />
    <Copy SourceFiles="@(NativeFfmpegRuntime)" DestinationFolder="$(TargetDir)ffmpeg-native" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="GenerateBuildVersion" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <BuildDate>$([System.DateTime]::Now.ToString("yyyyMMdd"))</BuildDate>
      <RandomNum>$([System.Guid]::NewGuid().ToString().Substring(0, 4))</RandomNum>
      <RandomBuildString>build.$(BuildDate).$(RandomNum)</RandomBuildString>
      <VersionFileContent>
// &lt;auto-generated/&gt;
namespace TerminalSimulation.Wpf%3B
public static class AppVersionInfo
{
    public const string AppVersion = "$(AppVersion)"%3B
    public const string BuildVersion = "$(RandomBuildString)"%3B
    public const string FullVersion = AppVersion + "-" + BuildVersion%3B
}
      </VersionFileContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)AppVersionInfo.g.cs" Lines="$(VersionFileContent)" Overwrite="true" WriteOnlyWhenDifferent="false" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)AppVersionInfo.g.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)libvlc.zip">
      <LogicalName>libvlc.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="EmbedLibVLC" BeforeTargets="BeforeResGen;PrepareForBuild">
    <PropertyGroup>
      <LibVlcSourceDir>$(PkgVideoLAN_LibVLC_Windows)\build\x64</LibVlcSourceDir>
      <LibVlcZipPath>$(IntermediateOutputPath)libvlc.zip</LibVlcZipPath>
    </PropertyGroup>
    <!-- 动态压缩 LibVLC 的原生库并作为内嵌资源嵌入 -->
    <ZipDirectory SourceDirectory="$(LibVlcSourceDir)" DestinationFile="$(LibVlcZipPath)" Overwrite="true" Condition="Exists('$(LibVlcSourceDir)')" />
  </Target>

</Project>
