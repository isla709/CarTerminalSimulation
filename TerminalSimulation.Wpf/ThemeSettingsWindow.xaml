<Window x:Class="TerminalSimulation.Wpf.ThemeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TerminalSimulation.Wpf"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Title="个性化设置" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Open Transition Storyboard -->
        <Storyboard x:Key="OpenStoryboard">
            <!-- Fade in Background Overlay -->
            <DoubleAnimation Storyboard.TargetName="BgOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            
            <!-- Zoom in Settings Control -->
            <DoubleAnimation Storyboard.TargetName="SettingsControl"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.85" To="1.0"
                             Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SettingsControl"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.85" To="1.0"
                             Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            
            <!-- Fade in Settings Control -->
            <DoubleAnimation Storyboard.TargetName="SettingsControl"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Close Transition Storyboard -->
        <Storyboard x:Key="CloseStoryboard">
            <!-- Fade out Background Overlay -->
            <DoubleAnimation Storyboard.TargetName="BgOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            
            <!-- Zoom out Settings Control -->
            <DoubleAnimation Storyboard.TargetName="SettingsControl"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1.0" To="0.85"
                             Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SettingsControl"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1.0" To="0.85"
                             Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            
            <!-- Fade out Settings Control -->
            <DoubleAnimation Storyboard.TargetName="SettingsControl"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource OpenStoryboard}" />
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- Background semi-transparent overlay to block main window input and close settings on left-click -->
        <Grid x:Name="BgOverlay" Background="#A0000000">
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseSettingsCommand}" />
            </Grid.InputBindings>
        </Grid>
        <!-- The actual settings control centered -->
        <local:ThemeSettingsControl x:Name="SettingsControl" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5">
            <local:ThemeSettingsControl.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </local:ThemeSettingsControl.RenderTransform>
        </local:ThemeSettingsControl>
    </Grid>
</Window>
