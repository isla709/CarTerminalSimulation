<UserControl x:Class="TerminalSimulation.Wpf.AboutSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="68" Height="68" CornerRadius="20"
                        Background="{DynamicResource MaterialDesign.Brush.Primary}">
                    <materialDesign:PackIcon Kind="CarConnected" Width="36" Height="36"
                                             Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="车载定位终端模拟系统"
                               FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="JT808 / JT1078 终端仿真与协议调试平台"
                               Margin="0,5,0,0" FontSize="13"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <TextBlock Margin="0,8,0,0" FontFamily="Consolas" FontSize="12"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                               Text="{Binding AppVersionText, StringFormat=当前版本  {0}}" />
                </StackPanel>
            </Grid>

            <Border Margin="0,24,0,0" Padding="18" CornerRadius="12"
                    Background="{DynamicResource MaterialDesignSelection}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="RocketLaunchOutline" Width="23" Height="23"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Preview7 版本简介" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="21"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   Text="本版本完善了实用工具工作区，新增 HTTP 请求调试与结构化代码编辑，扩充主题和启动封面，并加入由独立 update.exe 执行的多源安全更新能力。" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="主要功能" Margin="0,24,0,12" FontSize="15" FontWeight="SemiBold" />
            <UniformGrid Columns="3">
                <Border Margin="0,0,8,0" Padding="14" CornerRadius="10"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="AccessPointNetwork" Width="22" Height="22"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                        <TextBlock Text="协议仿真" Margin="0,9,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="JT808 报文、定位、串口与平台指令交互"
                                   Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    </StackPanel>
                </Border>
                <Border Margin="4,0" Padding="14" CornerRadius="10"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="VideoWirelessOutline" Width="22" Height="22"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                        <TextBlock Text="音视频能力" Margin="0,9,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="JT1078 多通道推流与进程内媒体转码"
                                   Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    </StackPanel>
                </Border>
                <Border Margin="8,0,0,0" Padding="14" CornerRadius="10"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ToolboxOutline" Width="22" Height="22"
                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                        <TextBlock Text="调试工具" Margin="0,9,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="报文解析、HTTP 调试及可扩展插件工作区"
                                   Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="技术方案" Margin="0,24,0,12" FontSize="15" FontWeight="SemiBold" />
            <WrapPanel>
                <Border Margin="0,0,8,8" Padding="12,7" CornerRadius="16" Background="{DynamicResource MaterialDesignSelection}">
                    <TextBlock Text=".NET 8" FontWeight="SemiBold" />
                </Border>
                <Border Margin="0,0,8,8" Padding="12,7" CornerRadius="16" Background="{DynamicResource MaterialDesignSelection}">
                    <TextBlock Text="WPF + MVVM" FontWeight="SemiBold" />
                </Border>
                <Border Margin="0,0,8,8" Padding="12,7" CornerRadius="16" Background="{DynamicResource MaterialDesignSelection}">
                    <TextBlock Text="Material Design 3" FontWeight="SemiBold" />
                </Border>
                <Border Margin="0,0,8,8" Padding="12,7" CornerRadius="16" Background="{DynamicResource MaterialDesignSelection}">
                    <TextBlock Text="进程内 FFmpeg" FontWeight="SemiBold" />
                </Border>
                <Border Margin="0,0,8,8" Padding="12,7" CornerRadius="16" Background="{DynamicResource MaterialDesignSelection}">
                    <TextBlock Text="动态插件架构" FontWeight="SemiBold" />
                </Border>
                <Border Margin="0,0,8,8" Padding="12,7" CornerRadius="16" Background="{DynamicResource MaterialDesignSelection}">
                    <TextBlock Text="独立安全更新器" FontWeight="SemiBold" />
                </Border>
            </WrapPanel>

            <Border Margin="0,18,0,0" Padding="18,15" CornerRadius="12"
                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#9E9E9E" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                <Setter Property="Fill" Value="#4CAF50" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="软件更新" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateToolTip}" Margin="16,5,0,0" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InvertBooleanConverter}}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            MinWidth="118" Height="38" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Update" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="版本管理" />
                        </StackPanel>
                    </Button>
                    <ProgressBar Grid.Column="1" Height="3" Margin="3,0,3,-2"
                                 VerticalAlignment="Bottom" IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCheckingForUpdates}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>
            </Border>

            <Border Margin="0,12,0,0" Padding="18,13" CornerRadius="12"
                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="测试版本通道" FontWeight="SemiBold" />
                        <TextBlock Text="正式版默认只检查正式版；开启后可查看 Preview、Beta、Test 等测试序列。Preview 版本始终只在同一序列内切换。"
                                   Margin="0,4,18,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              IsChecked="{Binding IncludePrereleaseUpdates, Mode=TwoWay}"
                              IsEnabled="{Binding IsStableRelease}"
                              Content="允许测试版本" FontWeight="SemiBold"
                              ToolTip="仅正式版启用此开关后才会显示测试版本" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
