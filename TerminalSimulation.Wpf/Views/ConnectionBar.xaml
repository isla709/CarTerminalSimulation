<UserControl x:Class="TerminalSimulation.Wpf.Views.ConnectionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel Margin="16,12,16,8">
      <WrapPanel Orientation="Horizontal">
        <ComboBox materialDesign:HintAssist.Hint="服务器地址 (IP/域名:端口)"
                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                  IsEditable="True" Text="{Binding ServerAddressInput, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding ServerAddressHistory}" Width="200" Margin="0,0,16,10" />
        <TextBox materialDesign:HintAssist.Hint="终端手机号"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 Text="{Binding TerminalPhoneNo}" Width="150" Margin="0,0,16,10" />
        <TextBox materialDesign:HintAssist.Hint="鉴权码"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 Text="{Binding AuthCode}" Width="100" Margin="0,0,16,10" />
        <ComboBox materialDesign:HintAssist.Hint="协议版本"
                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                  Width="110" Margin="0,0,16,10" SelectedIndex="{Binding ProtocolVersionIndex}">
            <ComboBoxItem Content="JT808-2013" />
            <ComboBoxItem Content="JT808-2019" />
        </ComboBox>
        <Button Content="连接" Command="{Binding ConnectCommand}" Margin="0,0,8,10"
                IsEnabled="{Binding IsConnected, Converter={StaticResource InvertBooleanConverter}}" Foreground="White" />
        <Button Content="断开" Command="{Binding DisconnectCommand}"
                Style="{StaticResource MaterialDesignOutlinedButton}" IsEnabled="{Binding IsConnected}" Margin="0,0,16,10" />
        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,4,16,10" />
        <Button Content="导出" Command="{Binding ExportConfigCommand}"
                Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,10"
                ToolTip="导出当前所有配置到 JSON 文件" />
        <Button Content="导入" Command="{Binding ImportConfigCommand}"
                Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,0,10"
                ToolTip="从 JSON 文件导入配置" />
      </WrapPanel>
    </StackPanel>
</UserControl>
