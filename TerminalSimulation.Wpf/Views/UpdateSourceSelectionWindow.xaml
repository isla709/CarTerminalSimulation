<Window x:Class="TerminalSimulation.Wpf.Views.UpdateSourceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="选择下载来源" Width="690" Height="510" MinWidth="620" MinHeight="450"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI" Loaded="Window_Loaded" Closing="Window_Closing">
    <Border Margin="18" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="18"
            BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.28" />
        </Border.Effect>
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="14" Background="#162196F3">
                    <materialDesign:PackIcon Kind="DownloadNetworkOutline" Width="25" Height="25"
                                             Foreground="#2196F3" HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="选择下载来源" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                </StackPanel>
                <Button Grid.Column="2" Click="Cancel_Click" Width="42" Height="42"
                        Padding="0" Background="Transparent" BorderThickness="0" ToolTip="关闭">
                    <TextBlock Text="×" FontFamily="Segoe UI Symbol" FontSize="28" FontWeight="Light"
                               Foreground="#59636E" Margin="0,-2,0,0" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="0,22,0,14" Padding="14,10" CornerRadius="10"
                    Background="{DynamicResource MaterialDesignSelection}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar x:Name="ProbeProgress" Width="110" Height="4" IsIndeterminate="True" />
                        <TextBlock x:Name="ProbeSummaryText" Margin="12,0,0,0" Text="正在并行检测所有下载源…"
                                   FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="重新检测" Click="Retry_Click"
                            Padding="12,5" Background="Transparent" BorderThickness="0"
                            Foreground="#1976D2" FontWeight="SemiBold" />
                </Grid>
            </Border>

            <ListBox x:Name="SourceList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                     SelectionChanged="SourceList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16,13" CornerRadius="11" BorderThickness="1"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="11" Background="#122196F3">
                                    <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="21" Height="21"
                                                             Foreground="#2196F3" HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                        <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="8" Background="#162196F3"
                                                Visibility="{Binding RecommendedVisibility}">
                                            <TextBlock Text="推荐" FontSize="10" Foreground="#1976D2" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Host}" Margin="0,4,0,0" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right"
                                               FontWeight="SemiBold" Foreground="{Binding StatusBrush}" />
                                    <TextBlock Text="{Binding MetricsText}" Margin="0,4,0,0" FontSize="11"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <TextBlock Text="只会下载所选来源；下载后仍会校验发布包的 SHA-256"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="取消" Click="Cancel_Click" Width="92" Height="40" Margin="0,0,12,0"
                            Padding="12,0" Background="#F3F6F9" Foreground="#455A64"
                            BorderBrush="#B0BEC5" BorderThickness="1" FontWeight="SemiBold" />
                    <Button x:Name="UseSourceButton" Content="使用所选来源" Click="UseSource_Click"
                            MinWidth="142" Height="40" Padding="16,0" IsEnabled="False"
                            Background="#2196F3" Foreground="White" BorderBrush="#2196F3"
                            FontWeight="SemiBold" Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
