<Window x:Class="TerminalSimulation.Wpf.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="版本管理" Width="760" Height="540" MinWidth="660" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI">
    <Border Margin="18" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="18"
            BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.28" />
        </Border.Effect>
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="14" Background="#162196F3">
                    <materialDesign:PackIcon Kind="SourceBranch" Width="25" Height="25" Foreground="#2196F3"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="版本管理" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="更新不是强制操作，你可以选择同一版本线中的任意兼容版本"
                               Margin="0,4,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="2" Click="Later_Click" Width="38" Height="38"
                        Background="Transparent" BorderThickness="0" ToolTip="关闭">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="0,22,0,16" Padding="16,12" CornerRadius="12"
                    Background="{DynamicResource MaterialDesignSelection}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前版本" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        <TextBlock x:Name="CurrentVersionText" Margin="0,4,0,0" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Margin="18,0,6,0" Padding="11,5" CornerRadius="13"
                            Background="{DynamicResource MaterialDesignPaper}" VerticalAlignment="Center">
                        <TextBlock x:Name="LineText" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border Grid.Column="2" Margin="6,0,0,0" Padding="11,5" CornerRadius="13"
                            Background="{DynamicResource MaterialDesignPaper}" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentCompatibilityText" FontSize="12" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="235" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="8" CornerRadius="12"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="可用版本" Margin="10,7,10,10" FontWeight="SemiBold" />
                        <ListBox x:Name="VersionList" Grid.Row="1"
                                 BorderThickness="0" Background="Transparent"
                                 SelectionChanged="VersionList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="7,6">
                                        <TextBlock Text="{Binding Version}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding PublishedAt, StringFormat={}{0:yyyy-MM-dd}}"
                                                       FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBlock Text="  ·  " FontSize="11"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBlock Text="{Binding SourceName}" FontSize="11"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Padding="18" CornerRadius="12"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TargetVersionText" FontSize="18" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Padding="11,5" CornerRadius="13" Background="#162196F3">
                                <TextBlock x:Name="DirectionText" Foreground="#1976D2" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TargetMetaText" Grid.Row="1" Margin="0,7,0,0" FontSize="11"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        <TextBlock Grid.Row="2" Text="版本说明" Margin="0,18,0,9" FontWeight="SemiBold" />
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" LineHeight="22"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="17" Height="17"
                                             Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <TextBlock Text="跨版本线和不兼容回退会被自动阻止"
                               Margin="7,0,0,0" FontSize="11"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" Click="Later_Click" Width="92" Height="40" Margin="0,0,12,0" />
                    <Button x:Name="InstallButton" Content="安装所选版本" Click="Install_Click"
                            MinWidth="142" Height="40" Padding="16,0"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
