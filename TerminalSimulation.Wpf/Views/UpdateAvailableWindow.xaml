<Window x:Class="TerminalSimulation.Wpf.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="发现新版本" Width="620" Height="470" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI">
    <Border Margin="18" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="18"
            BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.28" />
        </Border.Effect>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="14" Background="#162196F3">
                    <materialDesign:PackIcon Kind="Update" Width="25" Height="25" Foreground="#2196F3"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="发现新版本" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock x:Name="SourceText" Margin="0,4,0,0" Foreground="#777" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="2" Click="Later_Click" Width="38" Height="38" Background="Transparent" BorderThickness="0">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="0,24,0,0" Padding="18,14" CornerRadius="12" Background="#0F2196F3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前版本" Foreground="#777" FontSize="12" />
                        <TextBlock x:Name="CurrentVersionText" Margin="0,5,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <materialDesign:PackIcon Grid.Column="1" Kind="ArrowRight" Width="22" Height="22" Margin="20,0" VerticalAlignment="Center" Foreground="#2196F3" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="新版本" Foreground="#777" FontSize="12" />
                        <TextBlock x:Name="NewVersionText" Margin="0,5,0,0" Foreground="#1976D2" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2" Text="更新说明" Margin="0,22,0,10" FontWeight="SemiBold" FontSize="15" />
            <Border Grid.Row="3" Background="#08000000" CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" LineHeight="23" Foreground="#444" />
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="稍后" Click="Later_Click" Width="100" Height="40" Margin="0,0,12,0" />
                <Button Content="下载并安装" Click="Install_Click" Width="130" Height="40"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
