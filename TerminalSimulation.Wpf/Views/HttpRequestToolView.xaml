<UserControl x:Class="TerminalSimulation.Wpf.Views.HttpRequestToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TerminalSimulation.Wpf.Views.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="660" MinHeight="460"
             TextElement.FontSize="13"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="HttpCompactTextBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="InputBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Stretch" />
                            <TextBlock x:Name="InputHint"
                                       Text="{TemplateBinding Tag}"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="InputHint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HttpEditorTextBox" TargetType="TextBox" BasedOn="{StaticResource HttpCompactTextBox}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="HttpDataGrid" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource MaterialDesignSelection}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="ColumnHeaderHeight" Value="36" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
        </Style>

        <!-- HTTP 编辑器内部使用独立的紧凑标签样式。默认 MaterialDesign TabControl
             会将少量标签拉伸到整行，在宽屏下很难辨认其分组和选中状态。 -->
        <Style x:Key="HttpSectionTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                MinWidth="92"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <ContentPresenter Grid.Row="0"
                                                  Margin="0,0,0,2"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                                <Border x:Name="SelectionIndicator"
                                        Grid.Row="1"
                                        Height="3"
                                        Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                        CornerRadius="2"
                                        Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource MaterialDesignSelection}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
                                <Setter TargetName="SelectionIndicator" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HttpSectionTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource HttpSectionTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,8"
                                    Padding="4"
                                    Background="{DynamicResource MaterialDesignSelection}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <TabPanel IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          Background="Transparent" />
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- The outer utility host already provides the page surface. Keep this view
         as an inset workbench instead of stacking elevated white cards on it. -->
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" MinWidth="210" MaxWidth="380" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- Workspace and saved request list -->
        <Border Grid.Column="0"
                Padding="0"
                Background="Transparent"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="14,12,14,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30"
                                CornerRadius="8"
                                Background="{DynamicResource MaterialDesignSelection}">
                            <materialDesign:PackIcon Kind="Web"
                                                     Width="17" Height="17"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="HTTP 工作空间"
                                   Margin="9,0,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox Text="{Binding WorkspaceName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,9,0,0"
                             Height="40"
                             Tag="工作空间名称"
                             Style="{StaticResource HttpCompactTextBox}" />
                    <TextBlock Text="{Binding WorkspaceDisplayName}"
                               Margin="2,5,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,1,0,1"
                        Padding="8,6">
                    <UniformGrid Rows="1">
                        <Button Command="{Binding SaveWorkspaceCommand}"
                                Style="{StaticResource MaterialDesignToolButton}"
                                ToolTip="保存到 Workspaces/Http/.Save">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" />
                        </Button>
                        <Button Command="{Binding ImportWorkspaceCommand}"
                                Style="{StaticResource MaterialDesignToolButton}"
                                ToolTip="导入工作空间">
                            <materialDesign:PackIcon Kind="Import" Width="18" Height="18" />
                        </Button>
                        <Button Command="{Binding ExportWorkspaceCommand}"
                                Style="{StaticResource MaterialDesignToolButton}"
                                ToolTip="导出工作空间">
                            <materialDesign:PackIcon Kind="Export" Width="18" Height="18" />
                        </Button>
                    </UniformGrid>
                </Border>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Requests}"
                         SelectedItem="{Binding SelectedRequest}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,8" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Method}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Url}"
                                               Margin="0,2,0,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,1,0,0"
                        Padding="8,6">
                    <Grid>
                        <Button HorizontalAlignment="Left"
                                Command="{Binding NewRequestCommand}"
                                Style="{StaticResource MaterialDesignToolButton}"
                                ToolTip="新建请求">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" />
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding DuplicateRequestCommand}"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    ToolTip="复制请求">
                                <materialDesign:PackIcon Kind="ContentDuplicate" Width="18" Height="18" />
                            </Button>
                            <Button Command="{Binding DeleteRequestCommand}"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    ToolTip="删除请求">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="8"
                      Margin="3,12"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource MaterialDesignDivider}"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns" />

        <!-- Request and response editor -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5*" MinHeight="190" />
                <RowDefinition Height="6" />
                <RowDefinition Height="4*" MinHeight="150" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="10"
                    Margin="0,0,0,8"
                    Background="{DynamicResource MaterialDesignSelection}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding AvailableMethods}"
                              SelectedItem="{Binding SelectedRequest.Method}"
                              MinHeight="42"
                              Margin="0,0,8,0"
                              FontWeight="SemiBold"
                              materialDesign:HintAssist.Hint="方法" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SelectedRequest.Url, UpdateSourceTrigger=PropertyChanged}"
                             Height="42"
                             Margin="0,0,8,0"
                             FontFamily="Consolas"
                             Tag="https://api.example.com/resource"
                             Style="{StaticResource HttpCompactTextBox}" />
                    <Button Grid.Column="2"
                            Command="{Binding SendRequestCommand}"
                            Height="42" MinWidth="92"
                            Margin="0,0,8,0"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Send" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="发送" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3"
                            Command="{Binding CancelRequestCommand}"
                            Height="42" MinWidth="68"
                            Visibility="{Binding IsSending, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="取消" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="0" Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="12,10,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SelectedRequest.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 HorizontalAlignment="Stretch"
                                 Margin="0,0,18,0"
                                 FontWeight="SemiBold"
                                 Tag="请求名称"
                                 Style="{StaticResource HttpCompactTextBox}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="超时" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=LostFocus}"
                                     Width="58" Height="38"
                                     Padding="8,6"
                                     TextAlignment="Center"
                                     Style="{StaticResource HttpCompactTextBox}" />
                            <TextBlock Text="秒" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        </StackPanel>
                    </Grid>

                    <TabControl Grid.Row="1"
                                Margin="12,0,12,12"
                                Style="{StaticResource HttpSectionTabControl}">
                        <TabItem Header="查询参数">
                            <Grid Margin="10,8,10,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                    <Button Command="{Binding AddQueryParameterCommand}"
                                            Style="{StaticResource MaterialDesignToolButton}" ToolTip="添加参数">
                                        <materialDesign:PackIcon Kind="Plus" Width="17" Height="17" />
                                    </Button>
                                    <Button Command="{Binding RemoveQueryParameterCommand}"
                                            Style="{StaticResource MaterialDesignToolButton}" ToolTip="删除所选参数">
                                        <materialDesign:PackIcon Kind="Minus" Width="17" Height="17" />
                                    </Button>
                                </StackPanel>
                                <DataGrid Grid.Row="1"
                                          Style="{StaticResource HttpDataGrid}"
                                          ItemsSource="{Binding SelectedRequest.QueryParameters}"
                                          SelectedItem="{Binding SelectedQueryParameter}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="True"
                                          HeadersVisibility="Column"
                                          EnableRowVirtualization="True">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="54" />
                                        <DataGridTextColumn Header="参数名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTextColumn Header="值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="请求头">
                            <Grid Margin="10,8,10,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                    <Button Command="{Binding AddHeaderCommand}"
                                            Style="{StaticResource MaterialDesignToolButton}" ToolTip="添加请求头">
                                        <materialDesign:PackIcon Kind="Plus" Width="17" Height="17" />
                                    </Button>
                                    <Button Command="{Binding RemoveHeaderCommand}"
                                            Style="{StaticResource MaterialDesignToolButton}" ToolTip="删除所选请求头">
                                        <materialDesign:PackIcon Kind="Minus" Width="17" Height="17" />
                                    </Button>
                                </StackPanel>
                                <DataGrid Grid.Row="1"
                                          Style="{StaticResource HttpDataGrid}"
                                          ItemsSource="{Binding SelectedRequest.Headers}"
                                          SelectedItem="{Binding SelectedHeader}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="True"
                                          HeadersVisibility="Column"
                                          EnableRowVirtualization="True">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="54" />
                                        <DataGridTextColumn Header="请求头" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTextColumn Header="值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="正文">
                            <Grid Margin="10,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding AvailableContentTypes}"
                                              SelectedItem="{Binding SelectedRequest.ContentType}"
                                              Width="280"
                                              HorizontalAlignment="Left"
                                              materialDesign:HintAssist.Hint="Content-Type" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Command="{Binding FormatRequestBodyCommand}"
                                                Margin="0,0,4,0"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                ToolTip="格式化 JSON/XML">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CodeBraces" Width="16" Height="16" Margin="0,0,6,0" />
                                                <TextBlock Text="格式化" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding MinifyRequestBodyCommand}"
                                                Style="{StaticResource MaterialDesignToolButton}"
                                                ToolTip="压缩 JSON/XML">
                                            <materialDesign:PackIcon Kind="FormatLineSpacing" Width="18" Height="18" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <controls:StructuredCodeEditor Grid.Row="1"
                                                               Text="{Binding SelectedRequest.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               ContentType="{Binding SelectedRequest.ContentType}" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="2"
                          Height="6"
                          Margin="12,2"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource MaterialDesignDivider}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows" />

            <Border Grid.Row="3" Padding="0" Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="16,10"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ResponseStatus}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ResponseSummary}" Margin="14,0,0,0"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding CopyResponseBodyCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        ToolTip="复制响应正文">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="17" Height="17" />
                                </Button>
                                <Button Command="{Binding ClearResponseCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        ToolTip="清空响应">
                                    <materialDesign:PackIcon Kind="Broom" Width="17" Height="17" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TabControl Grid.Row="1"
                                Margin="12,10,12,12"
                                Style="{StaticResource HttpSectionTabControl}">
                        <TabItem Header="响应正文">
                            <controls:StructuredCodeEditor Text="{Binding ResponseBody}"
                                                           ContentType="{Binding ResponseContentType}"
                                                           IsReadOnly="True" />
                        </TabItem>
                        <TabItem Header="响应头">
                            <TextBox Text="{Binding ResponseHeaders}"
                                     Style="{StaticResource HttpEditorTextBox}"
                                     Margin="10"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="4,6,4,0">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             VerticalAlignment="Bottom"
                             Visibility="{Binding IsSending, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
