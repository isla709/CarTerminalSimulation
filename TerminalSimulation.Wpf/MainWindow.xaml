<Window x:Class="TerminalSimulation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:TerminalSimulation.Wpf.ViewModels"
        xmlns:converters="clr-namespace:TerminalSimulation.Wpf.Converters"
        xmlns:local="clr-namespace:TerminalSimulation.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        FontFamily="Microsoft YaHei, Segoe UI, sans-serif"
        Title="车载定位终端模拟系统 (JT808)" Width="{Binding ConfigWindowWidth, Mode=TwoWay}" Height="{Binding ConfigWindowHeight, Mode=TwoWay}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize">
    
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="1" CornerRadius="0" CaptionHeight="40" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToHiddenVisibilityConverter x:Key="BooleanToHiddenVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:WidthToColumnsConverter x:Key="WidthToColumnsConverter" />
        <converters:AspectRatioConverter x:Key="AspectRatioConverter" />
        
        <!-- Ensure Cards respond dynamically to background brush changes -->
        <Style TargetType="{x:Type materialDesign:Card}" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
            <Setter Property="local:GlassBehavior.IsEnabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BackgroundEffectMode}" Value="None">
                    <Setter Property="local:GlassBehavior.IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BackgroundImagePath}" Value="{x:Null}">
                    <Setter Property="local:GlassBehavior.IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BackgroundImagePath}" Value="">
                    <Setter Property="local:GlassBehavior.IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#F1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BackgroundEffectMode}" Value="Translucent">
                    <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BackgroundEffectMode}" Value="Blur">
                    <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BackgroundEffectMode}" Value="Acrylic">
                    <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BackgroundImagePath}" Value="">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Grid x:Name="LayoutRoot">


        <Grid>
            <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Background Sharp Image -->
        <Image Source="{Binding BackgroundImageSource}" Stretch="UniformToFill" Grid.RowSpan="3" Panel.ZIndex="-2">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BackgroundImagePath}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding BackgroundImagePath}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>

        <!-- Blurred Background Layer for Glass Effect (Always visible but z-indexed behind the sharp image) -->
        <Grid x:Name="RootBlurredImage" Grid.RowSpan="3" Panel.ZIndex="-3">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BackgroundEffectMode}" Value="None">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- If no image, fallback to solid color -->
                        <DataTrigger Binding="{Binding BackgroundImagePath}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding BackgroundImagePath}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            
            <Image Source="{Binding BackgroundImageSource}" Stretch="UniformToFill">
                <Image.Style>
                    <Style TargetType="Image">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BackgroundEffectMode}" Value="Blur">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect Radius="20" RenderingBias="Performance" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BackgroundEffectMode}" Value="Acrylic">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect Radius="40" RenderingBias="Performance" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            
            <Border Background="{DynamicResource MaterialDesignPaper}" Opacity="{Binding BackgroundOpacity}" />
        </Grid>

        <!-- Custom Title Bar -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0">
                    <materialDesign:PackIcon Kind="CarConnected" Foreground="White" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding AppTitle}" Foreground="White" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" />
                </StackPanel>

                <!-- Status and Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    
                    <!-- Terminal Status -->
                    <Border Background="White" CornerRadius="12" Margin="0,8,16,8" Padding="12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{Binding TerminalStatusColor}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding TerminalStatusText}" Foreground="#333" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Analyzer Button -->
                    <ToggleButton IsChecked="{Binding IsAnalyzerVisible}" Style="{StaticResource MaterialDesignActionToggleButton}" Width="30" Height="30" Background="Transparent" BorderThickness="0" ToolTip="报文解析器" Foreground="White" Margin="0,0,8,0">
                        <ToggleButton.Content>
                            <materialDesign:PackIcon Kind="CodeJson" Width="18" Height="18" />
                        </ToggleButton.Content>
                        <materialDesign:ToggleButtonAssist.OnContent>
                            <materialDesign:PackIcon Kind="KeyboardReturn" Width="18" Height="18" />
                        </materialDesign:ToggleButtonAssist.OnContent>
                    </ToggleButton>

                    <!-- Settings Button -->
                    <Button Click="BtnSettings_Click" Style="{StaticResource TitleBarButtonStyle}" ToolTip="个性化设置">
                        <materialDesign:PackIcon Kind="TshirtCrew" Width="16" Height="16" />
                    </Button>

                    <!-- Minimize Button -->
                    <Button Click="BtnMinimize_Click" Style="{StaticResource TitleBarButtonStyle}">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14" />
                    </Button>
                    <!-- Maximize/Restore Button -->
                    <Button Click="BtnMaximize_Click" Style="{StaticResource TitleBarButtonStyle}">
                        <materialDesign:PackIcon Kind="WindowMaximize" Width="14" Height="14" />
                    </Button>
                    <!-- Close Button -->
                    <Button Click="BtnClose_Click" Style="{StaticResource TitleBarCloseButtonStyle}">
                        <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Normal Main Content Wrapper -->
        <Grid Grid.Row="1" Grid.RowSpan="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Opacity" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAnalyzerVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsAnalyzerVisible}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Config Area -->
            <materialDesign:Card Grid.Row="0" Margin="8">
                <StackPanel Orientation="Horizontal" Margin="16">
                <TextBox materialDesign:HintAssist.Hint="服务器 IP" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding ServerIp}" Width="120" Margin="0,0,16,0" />
                <TextBox materialDesign:HintAssist.Hint="端口" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding ServerPort}" Width="60" Margin="0,0,16,0" />
                <TextBox materialDesign:HintAssist.Hint="终端手机号" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding TerminalPhoneNo}" Width="150" Margin="0,0,16,0" />
                <TextBox materialDesign:HintAssist.Hint="鉴权码" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding AuthCode}" Width="100" Margin="0,0,16,0" />
                <ComboBox materialDesign:HintAssist.Hint="协议版本" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Width="100" Margin="0,0,16,0" SelectedIndex="{Binding ProtocolVersionIndex}">
                    <ComboBoxItem Content="JT808-2013" />
                    <ComboBoxItem Content="JT808-2019" />
                </ComboBox>
                
                <Button Content="连接" Command="{Binding ConnectCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsConnected, Converter={StaticResource InvertBooleanConverter}}" Foreground="White" />
                <Button Content="断开" Command="{Binding DisconnectCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" IsEnabled="{Binding IsConnected}" Margin="0,0,16,0" />
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,4,16,4" />
                <Button Content="导出" Command="{Binding ExportConfigCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0" ToolTip="导出当前所有配置到 JSON 文件" />
                <Button Content="导入" Command="{Binding ImportConfigCommand}" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="从 JSON 文件导入配置" />
            </StackPanel>
        </materialDesign:Card>

        <Grid Grid.Row="1" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Control Area -->
            <ScrollViewer Grid.Column="0" Margin="0,0,8,0" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <!-- Core Actions -->
                    <materialDesign:Card Margin="0,0,0,8">
                        <StackPanel Margin="16">
                            <TextBlock Text="设备注册与鉴权" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,16" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="终端注册" Command="{Binding RegisterCommand}" Margin="0,0,16,0" Width="150" Foreground="White" />
                                <Button Content="终端鉴权" Command="{Binding AuthCommand}" Width="150" Foreground="White" />
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Terminal Heartbeat -->
                    <materialDesign:Card Margin="0,0,0,8">
                        <StackPanel Margin="16">
                            <TextBlock Text="终端心跳保活 (0x0002)" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,16" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox materialDesign:HintAssist.Hint="心跳间隔 (秒)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding HeartbeatInterval}" Width="100" Margin="0,0,16,0" IsEnabled="{Binding IsHeartbeatDisabled, Converter={StaticResource InvertBooleanConverter}}" />
                                <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding IsHeartbeatDisabled}" VerticalAlignment="Bottom" Margin="0,0,8,4" />
                                <TextBlock Text="关闭自动心跳" VerticalAlignment="Bottom" Margin="0,0,0,6" Foreground="#666" />
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Location Report -->
                    <materialDesign:Card Margin="0,0,0,8">
                        <StackPanel Margin="16">
                            <TextBlock Text="位置汇报 (0x0200)" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,16" />
                            
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="纬度 (Lat)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding Latitude}" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="经度 (Lng)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding Longitude}" Margin="8,0,0,0" />
                            </Grid>
                            
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="速度 (km/h)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding Speed}" Margin="0,0,0,0" />
                                <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="方向 (0-359)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding Direction}" />
                                <TextBox Grid.Column="4" materialDesign:HintAssist.Hint="高程 (m)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding Altitude}" />
                            </Grid>

                            <Expander Header="报警标志设置" Margin="0,0,0,8" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                <ItemsControl ItemsSource="{Binding AlarmFlags}" Margin="8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,0,16,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <Expander Header="车辆状态设置" Margin="0,0,0,16" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                <ItemsControl ItemsSource="{Binding StatusFlags}" Margin="8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,0,16,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <Expander Header="标准附加信息 (0x0200)" IsExpanded="False" Background="Transparent" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                <WrapPanel Orientation="Horizontal" Margin="8">
                                    <StackPanel Orientation="Vertical" Margin="0,0,16,16">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Enable0x01}" Content="0x01 里程(1/10km):" VerticalAlignment="Center" Width="190" />
                                            <TextBox Text="{Binding Mileage0x01}" Width="70" IsEnabled="{Binding Enable0x01}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="24,4,0,0">
                                            <CheckBox IsChecked="{Binding EnableMileageSimulation}" Content="按速推算" VerticalAlignment="Center" ToolTip="根据车速自动计算里程累加"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Vertical" Margin="0,0,16,16">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Enable0x02}" Content="0x02 油量(1/10L):" VerticalAlignment="Center" Width="190" />
                                            <TextBox Text="{Binding Oil0x02}" Width="70" IsEnabled="{Binding Enable0x02}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="24,4,0,0">
                                            <CheckBox IsChecked="{Binding EnableOilConsumption}" Content="自动消耗" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="开启后根据设定的百公里油耗自动扣减"/>
                                            <TextBox Text="{Binding OilConsumptionRate}" Width="50" IsEnabled="{Binding EnableOilConsumption}" VerticalAlignment="Center" ToolTip="百公里油耗 (L)"/>
                                            <TextBlock Text="L/100km" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Vertical" Margin="0,0,16,16">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Enable0x03}" Content="0x03 速度(1/10km/h):" VerticalAlignment="Center" Width="190" />
                                            <TextBox Text="{Binding Speed0x03}" Width="70" IsEnabled="{Binding Enable0x03}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="24,4,0,0">
                                            <CheckBox IsChecked="{Binding Sync0x03SpeedWithMainSpeed}" Content="同步主速度" VerticalAlignment="Center" ToolTip="勾选后自动与外层0200的全局速度同步"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Vertical" Margin="0,0,16,16">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Enable0x04}" Content="0x04 报警事件ID:" VerticalAlignment="Center" Width="190" />
                                            <TextBox Text="{Binding AlarmEventId0x04}" Width="70" IsEnabled="{Binding Enable0x04}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Vertical" Margin="0,0,16,16">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Enable0x25}" Content="0x25 车辆信号状态:" VerticalAlignment="Center" Width="190" />
                                            <TextBox Text="{Binding ExtVehicleSignal0x25}" Width="70" IsEnabled="{Binding Enable0x25}" VerticalAlignment="Center" />
                                            <ToggleButton x:Name="VehSigDetailsButton" Style="{StaticResource MaterialDesignActionToggleButton}" IsEnabled="{Binding Enable0x25}" VerticalAlignment="Center" Margin="8,0,0,0" Width="30" Height="30" Background="Transparent" BorderThickness="0" ToolTip="设置信号状态详细位" Foreground="{DynamicResource PrimaryHueMidBrush}">
                                                <ToggleButton.Content>
                                                    <materialDesign:PackIcon Kind="Settings" Width="20" Height="20"/>
                                                </ToggleButton.Content>
                                                <materialDesign:ToggleButtonAssist.OnContent>
                                                    <materialDesign:PackIcon Kind="Settings" Width="20" Height="20"/>
                                                </materialDesign:ToggleButtonAssist.OnContent>
                                            </ToggleButton>
                                            <Popup IsOpen="{Binding IsChecked, ElementName=VehSigDetailsButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=VehSigDetailsButton}" Placement="Bottom" PopupAnimation="Fade" AllowsTransparency="True">
                                                <Border Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4" Padding="12" Width="360" SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="车辆信号状态开关 (Bit 0-14)" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                        <UniformGrid Grid.Row="1" Columns="2">
                                                            <CheckBox Content="0: 近光灯" IsChecked="{Binding ExtVehSigLowBeam}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="1: 远光灯" IsChecked="{Binding ExtVehSigHighBeam}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="2: 右转向灯" IsChecked="{Binding ExtVehSigRightTurn}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="3: 左转向灯" IsChecked="{Binding ExtVehSigLeftTurn}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="4: 制动信号" IsChecked="{Binding ExtVehSigBrake}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="5: 倒档" IsChecked="{Binding ExtVehSigReverse}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="6: 雾灯" IsChecked="{Binding ExtVehSigFogLight}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="7: 示廓灯" IsChecked="{Binding ExtVehSigOutlineLight}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="8: 喇叭" IsChecked="{Binding ExtVehSigHorn}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="9: 空调" IsChecked="{Binding ExtVehSigAC}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="10: 空挡" IsChecked="{Binding ExtVehSigNeutral}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="11: 缓速器工作" IsChecked="{Binding ExtVehSigRetarder}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="12: ABS 工作" IsChecked="{Binding ExtVehSigABS}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="13: 加热器工作" IsChecked="{Binding ExtVehSigHeater}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="14: 离合器状态" IsChecked="{Binding ExtVehSigClutch}" Margin="0,4,8,4"/>
                                                        </UniformGrid>
                                                    </Grid>
                                                </Border>
                                            </Popup>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Vertical" Margin="0,0,16,16">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Enable0x2A}" Content="0x2A IO状态位:" VerticalAlignment="Center" Width="190" />
                                            <TextBox Text="{Binding IOStatus0x2A}" Width="70" IsEnabled="{Binding Enable0x2A}" VerticalAlignment="Center" />
                                            <ToggleButton x:Name="IOStatusDetailsButton" Style="{StaticResource MaterialDesignActionToggleButton}" IsEnabled="{Binding Enable0x2A}" VerticalAlignment="Center" Margin="8,0,0,0" Width="30" Height="30" Background="Transparent" BorderThickness="0" ToolTip="设置IO状态详细位" Foreground="{DynamicResource PrimaryHueMidBrush}">
                                                <ToggleButton.Content>
                                                    <materialDesign:PackIcon Kind="Settings" Width="20" Height="20"/>
                                                </ToggleButton.Content>
                                                <materialDesign:ToggleButtonAssist.OnContent>
                                                    <materialDesign:PackIcon Kind="Settings" Width="20" Height="20"/>
                                                </materialDesign:ToggleButtonAssist.OnContent>
                                            </ToggleButton>
                                            <Popup IsOpen="{Binding IsChecked, ElementName=IOStatusDetailsButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=IOStatusDetailsButton}" Placement="Bottom" PopupAnimation="Fade" AllowsTransparency="True">
                                                <Border Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4" Padding="12" Width="360" SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="IO状态位开关 (Bit 0-15)" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                        <UniformGrid Grid.Row="1" Columns="2">
                                                            <CheckBox Content="0: 深度休眠状态" IsChecked="{Binding IOStatusDeepSleep}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="1: 休眠状态" IsChecked="{Binding IOStatusSleep}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="2: GPIO2" IsChecked="{Binding IOStatusGPIO2}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="3: GPIO3" IsChecked="{Binding IOStatusGPIO3}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="4: GPIO4" IsChecked="{Binding IOStatusGPIO4}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="5: GPIO5" IsChecked="{Binding IOStatusGPIO5}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="6: GPIO6" IsChecked="{Binding IOStatusGPIO6}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="7: GPIO7" IsChecked="{Binding IOStatusGPIO7}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="8: GPIO8" IsChecked="{Binding IOStatusGPIO8}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="9: GPIO9" IsChecked="{Binding IOStatusGPIO9}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="10: GPIO10" IsChecked="{Binding IOStatusGPIO10}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="11: GPIO11" IsChecked="{Binding IOStatusGPIO11}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="12: GPIO12" IsChecked="{Binding IOStatusGPIO12}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="13: GPIO13" IsChecked="{Binding IOStatusGPIO13}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="14: GPIO14" IsChecked="{Binding IOStatusGPIO14}" Margin="0,4,8,4"/>
                                                            <CheckBox Content="15: GPIO15" IsChecked="{Binding IOStatusGPIO15}" Margin="0,4,8,4"/>
                                                        </UniformGrid>
                                                    </Grid>
                                                </Border>
                                            </Popup>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Vertical" Margin="0,0,16,16">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Enable0x2B}" Content="0x2B 模拟量:" VerticalAlignment="Center" Width="190" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="24,4,0,0">
                                            <TextBlock Text="AD1" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <Slider Minimum="0" Maximum="65535" Value="{Binding AnalogAD1}" Width="100" IsEnabled="{Binding Enable0x2B}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding AnalogAD1}" Width="45" IsEnabled="{Binding Enable0x2B}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="24,4,0,0">
                                            <TextBlock Text="AD2" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <Slider Minimum="0" Maximum="65535" Value="{Binding AnalogAD0}" Width="100" IsEnabled="{Binding Enable0x2B}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding AnalogAD0}" Width="45" IsEnabled="{Binding Enable0x2B}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Vertical" Margin="0,0,16,16">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Enable0x30}" Content="0x30 网络信号强度:" VerticalAlignment="Center" Width="190" />
                                            <TextBox Text="{Binding NetworkSignal0x30}" Width="70" IsEnabled="{Binding Enable0x30}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="24,4,0,0">
                                            <CheckBox IsChecked="{Binding EnableNetworkSignalFluctuation}" Content="随机波动" VerticalAlignment="Center" ToolTip="在基准值上增加±1的小幅随机跳动"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Vertical" Margin="0,0,16,16">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Enable0x31}" Content="0x31 GNSS卫星数:" VerticalAlignment="Center" Width="190" />
                                            <TextBox Text="{Binding GNSSCount0x31}" Width="70" IsEnabled="{Binding Enable0x31}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="24,4,0,0">
                                            <CheckBox IsChecked="{Binding EnableGNSSFluctuation}" Content="随机波动" VerticalAlignment="Center" ToolTip="在基准值上增加±1的小幅随机跳动"/>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </Expander>

                            <Separator Margin="0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="附加信息 (Hex透传)" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource MaterialDesignToolButton}" Command="{Binding AddCustomAttachCommand}" ToolTip="添加一项附加信息" Margin="8,0,0,0">
                                    <TextBlock Text="➕" FontSize="12"/>
                                </Button>
                            </StackPanel>
                            
                            <ItemsControl ItemsSource="{Binding CustomAttachItems}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="字段 ID" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding AttachId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                            <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="长度" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding AttachLength, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="数据内容 (Hex)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding AttachData, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                            <Button Grid.Column="3" Style="{StaticResource MaterialDesignToolButton}" Command="{Binding DataContext.RemoveCustomAttachCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="删除" VerticalAlignment="Bottom">
                                                <TextBlock Text="❌" FontSize="12" Foreground="Red"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="发送位置汇报" Command="{Binding ReportLocationCommand}" Foreground="White" />
                                
                                <TextBlock Grid.Column="2" Text="自动发送" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="4" 
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              IsChecked="{Binding IsAutoReporting, Mode=OneWay}"
                                              Command="{Binding ToggleAutoReportCommand}"
                                              ToolTip="开启/关闭自动循环发送" />
                                              
                                <TextBox Grid.Column="6" materialDesign:HintAssist.Hint="间隔 (秒)" 
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                         Text="{Binding AutoReportInterval}" Margin="0,-16,0,0" />
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Advanced & Logs Area -->
            <materialDesign:Card Grid.Column="1">
                <TabControl x:Name="MainTabControl" Style="{StaticResource MaterialDesignTabControl}" SelectionChanged="MainTabControl_SelectionChanged">
                    <TabItem Header="通信日志">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,4">
                                <CheckBox Content="自动滚动至最新" IsChecked="{Binding AutoScrollLogs}" Margin="0,0,16,0" />
                                <Button Content="清空日志" Command="{Binding ClearLogsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="24" Padding="8,0" />
                            </StackPanel>
                            <ListBox Grid.Row="1" x:Name="LogListBox" 
                                     materialDesign:ThemeAssist.Theme="Dark"
                                     ItemsSource="{Binding LogMessages}"
                                     Background="#1E1E1E" Foreground="#D4D4D4" 
                                     Margin="8,0,8,8" Padding="4"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     VirtualizingStackPanel.ScrollUnit="Pixel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="24" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="复制整条日志 (Ctrl+C)" Command="{Binding CopyFullLogCommand}" />
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimestampStr}" Foreground="#888888" FontFamily="Consolas" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding DirectionStr}" Foreground="{DynamicResource PrimaryHueLightBrush}" FontFamily="Consolas" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Top" />
                                            <Button Grid.Column="2" Content="复制" Command="{Binding CopyRawCommand}" Visibility="{Binding HasRaw, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="20" Padding="4,0" Margin="0,0,8,0" FontSize="10" 
                                                    Foreground="{DynamicResource SecondaryHueLightBrush}" BorderBrush="{DynamicResource SecondaryHueLightBrush}" VerticalAlignment="Top" />
                                            <TextBox Grid.Column="3" Text="{Binding Message}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#D4D4D4" 
                                                     FontFamily="Consolas" FontSize="13" VerticalAlignment="Top" SelectionBrush="{DynamicResource PrimaryHueLightBrush}"
                                                     ContextMenu="{x:Null}" TextWrapping="Wrap" materialDesign:TextFieldAssist.DecorationVisibility="Hidden" materialDesign:TextFieldAssist.UnderlineBrush="Transparent" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="地图选点">
                        <Grid>
                            <wv2:WebView2 x:Name="MapWebView" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="数据透传">
                        <Grid Background="{DynamicResource MaterialDesignPaper}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <!-- Top Control Bar -->
                             <Border Grid.Row="0" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8">
                                 <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                     <TextBlock Text="串口:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                     <ComboBox ItemsSource="{Binding SerialPorts}" SelectedItem="{Binding SelectedSerialPort}" Width="90" Margin="0,0,8,0" />
                                     
                                     <TextBlock Text="波特率:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                     <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate}" Width="85" Margin="0,0,8,0" />
                                     
                                     <Button Command="{Binding ToggleSerialPortCommand}" Content="{Binding SerialPortBtnText}" 
                                             Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="12,0" Margin="4,0,8,0" />
                                     <Button Command="{Binding RefreshSerialPortsCommand}" ToolTip="刷新串口" 
                                             Style="{StaticResource MaterialDesignToolButton}" Height="28" Width="28" Padding="0">
                                         <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" />
                                     </Button>

                                     <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,4,16,4" />

                                     <TextBlock Text="聊天框显示编码:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                     <ComboBox SelectedIndex="{Binding ChatEncodingIndex}" Width="85" Margin="0,0,12,0">
                                         <ComboBoxItem Content="GBK" />
                                         <ComboBoxItem Content="UTF-8" />
                                         <ComboBoxItem Content="HEX" />
                                     </ComboBox>
                                 </WrapPanel>
                             </Border>

                            <!-- Chat List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PassthroughMessages}" Margin="8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Server Message (Left) -->
                                                <StackPanel Grid.Column="0" HorizontalAlignment="Left" Visibility="{Binding IsFromServer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Time}" FontSize="10" Foreground="Gray" Margin="4,0,0,2" />
                                                    <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <TextBlock Text="{Binding TypeHex, StringFormat='类型: 0x{0}'}" FontSize="10" Foreground="Gray" />
                                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="Gray" Margin="8,0,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" MaxWidth="300" Foreground="{DynamicResource MaterialDesignBody}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Terminal Message (Right) -->
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Visibility="{Binding IsFromServer, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Time}" FontSize="10" Foreground="Gray" Margin="0,0,4,2" HorizontalAlignment="Right" />
                                                    <Border Background="{DynamicResource MaterialDesign.Brush.Primary}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,2">
                                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="White" Opacity="0.7" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding TypeHex, StringFormat='类型: 0x{0}'}" FontSize="10" Foreground="White" Opacity="0.7" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" MaxWidth="300" Foreground="White" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                             <!-- Bottom Input Bar -->
                             <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0" Padding="8">
                                 <Grid>
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="*" />
                                     </Grid.RowDefinitions>
                                     
                                     <!-- Send Encoding and Type Row -->
                                     <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                         <TextBlock Text="透传类型(HEX):" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                         <TextBox Text="{Binding PassthroughTypeHex, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,16,0" VerticalAlignment="Center" />
                                         
                                         <TextBlock Text="发送编码:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                         <ComboBox SelectedIndex="{Binding PassthroughEncodingIndex}" Width="85" Margin="0,0,16,0" VerticalAlignment="Center">
                                             <ComboBoxItem Content="GBK" />
                                             <ComboBoxItem Content="UTF-8" />
                                             <ComboBoxItem Content="HEX" />
                                         </ComboBox>
                                         
                                         <!-- HEX input validation message -->
                                         <TextBlock Text="⚠️ HEX 模式下字符长度必须为偶数" Foreground="Red" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"
                                                    Visibility="{Binding IsHexInputInvalid, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                     </StackPanel>
                                     
                                     <!-- Input Box and Send Button -->
                                     <Grid Grid.Row="1">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="Auto" />
                                         </Grid.ColumnDefinitions>
                                         <TextBox Grid.Column="0" Text="{Binding PassthroughInputText, UpdateSourceTrigger=PropertyChanged}" 
                                                  Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                  Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                  materialDesign:HintAssist.Hint="输入透传内容..." Margin="0,0,8,0" />
                                         <Button Grid.Column="1" Command="{Binding SendPassthroughCommand}" 
                                                 Height="60" Width="100" VerticalAlignment="Bottom"
                                                 Style="{StaticResource MaterialDesignRaisedButton}"
                                                 materialDesign:ButtonAssist.CornerRadius="8"
                                                 Cursor="Hand" Foreground="White">
                                             <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                 <materialDesign:PackIcon Kind="Send" Width="18" Height="18" Margin="0,0,8,0" />
                                                 <TextBlock Text="发送" FontWeight="Bold" FontSize="14" />
                                             </StackPanel>
                                         </Button>
                                     </Grid>
                                 </Grid>
                             </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="文本下发">
                        <Grid Background="{DynamicResource MaterialDesignPaper}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Control Panel (TTS settings) -->
                            <Border Grid.Row="0" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="12">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding EnableTTSPlayback}" Content="启用语音播放 (TTS)" VerticalAlignment="Center" Margin="0,0,24,0" Foreground="{DynamicResource MaterialDesignBody}" />
                                    
                                    <TextBlock Text="语音声音风格 (Voice):" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    <ComboBox ItemsSource="{Binding InstalledTTSVoices}" SelectedItem="{Binding SelectedTTSVoice}" Width="250" Margin="0,0,24,0" IsEnabled="{Binding EnableTTSPlayback}" />

                                    <TextBlock Text="文本解析编码 (Encoding):" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    <ComboBox SelectedIndex="{Binding TextDownlinkEncodingIndex}" Width="100" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <ComboBoxItem Content="UTF-8" />
                                        <ComboBoxItem Content="GBK" />
                                    </ComboBox>
                                </WrapPanel>
                            </Border>

                            <!-- Message Chat Panel -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding TextDownlinkMessages}" Margin="12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Outer row: bubble on left, replay button on right -->
                                            <Grid Margin="0,4,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Message Bubble -->
                                                <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}"
                                                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                                                        CornerRadius="8" Padding="12" MaxWidth="640" HorizontalAlignment="Left">
                                                    <StackPanel>
                                                        <!-- Header row: time + flag badges -->
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1" Background="{DynamicResource PrimaryHueLightBrush}" CornerRadius="4"
                                                                    Padding="6,2" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FlagsDescription}" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Message content -->
                                                        <TextBox Text="{Binding Content}" IsReadOnly="True" BorderThickness="0"
                                                                 Background="Transparent" Foreground="{DynamicResource MaterialDesignBody}"
                                                                 FontFamily="Consolas" FontSize="14" TextWrapping="Wrap"
                                                                 AcceptsReturn="True"
                                                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                                                 materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                                                 Margin="0,0,0,6"/>

                                                        <!-- Expandable detailed flags -->
                                                        <Expander Header="标志位详情" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="11">
                                                            <TextBox Text="{Binding DetailedFlagsText, Mode=OneWay}" IsReadOnly="True"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                     FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                                                     AcceptsReturn="True" Margin="8,4,0,0"
                                                                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"/>
                                                        </Expander>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Replay TTS Button -->
                                                <Button Grid.Column="1" VerticalAlignment="Top" Margin="8,2,0,0"
                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="重播TTS"
                                                        Command="{Binding DataContext.ReplayTTSCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="VolumeHigh" Width="20" Height="20"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="设备属性">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16" MinWidth="250">
                                <StackPanel.Resources>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                                        <Setter Property="Margin" Value="0,8,0,16" />
                                    </Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}">
                                        <Setter Property="Margin" Value="0,8,0,16" />
                                    </Style>
                                </StackPanel.Resources>
                                
                                <TextBlock Text="终端标识属性" FontWeight="Bold" FontSize="16" Margin="0,0,0,16" Foreground="{DynamicResource MaterialDesignBody}" />
                                
                                <ComboBox materialDesign:HintAssist.Hint="省域ID" IsEditable="True" Text="{Binding ProvinceIdInput}" ItemsSource="{Binding ProvinceList}" />
                                <ComboBox materialDesign:HintAssist.Hint="市县域ID" IsEditable="True" Text="{Binding CityIdInput}" ItemsSource="{Binding CityList}" />
                                <TextBox materialDesign:HintAssist.Hint="制造商ID (5字节)" Text="{Binding ManufacturerId}" MaxLength="5" />
                                <TextBox materialDesign:HintAssist.Hint="终端型号" Text="{Binding TerminalModel}" MaxLength="20" />
                                <TextBox materialDesign:HintAssist.Hint="终端ID" Text="{Binding TerminalId}" MaxLength="7" />
                                
                                <TextBlock Text="车辆与SIM卡属性" FontWeight="Bold" FontSize="16" Margin="0,16,0,16" Foreground="{DynamicResource MaterialDesignBody}" />
                                
                                <ComboBox materialDesign:HintAssist.Hint="车牌颜色" SelectedValue="{Binding PlateColor}" SelectedValuePath="Value" DisplayMemberPath="Name" ItemsSource="{Binding PlateColorList}" />
                                <TextBox materialDesign:HintAssist.Hint="车牌号" Text="{Binding PlateNo}" />
                                <TextBox materialDesign:HintAssist.Hint="SIM卡号 (ICCID)" Text="{Binding SimNumber}" />
                                <TextBox materialDesign:HintAssist.Hint="终端IMEI" Text="{Binding TerminalIMEI}" />
                                
                                <TextBlock Text="版本属性 (用于 0x8107 回复)" FontWeight="Bold" FontSize="16" Margin="0,16,0,16" Foreground="{DynamicResource MaterialDesignBody}" />
                                
                                <TextBox materialDesign:HintAssist.Hint="硬件版本号" Text="{Binding HardwareVersion}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                                    <ToggleButton IsChecked="{Binding UseAppVersionAsFirmwareVersion}" />
                                    <TextBlock Text="使用程序版本作为固件版本" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBox materialDesign:HintAssist.Hint="固件版本号" Text="{Binding FirmwareVersion}" IsEnabled="{Binding UseAppVersionAsFirmwareVersion, Converter={StaticResource InvertBooleanConverter}}" />
                                
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="视频控制">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="通道数量:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding IntRange1to36}" SelectedItem="{Binding VideoChannelCount}" Width="80"/>
                            </StackPanel>
                            
                            <ScrollViewer x:Name="VideoScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="True" ScrollChanged="VideoScrollViewer_ScrollChanged" SizeChanged="VideoScrollViewer_SizeChanged">
                                <ItemsControl x:Name="VideoItemsControl" ItemsSource="{Binding VideoChannels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding ElementName=VideoItemsControl, Path=ActualWidth, Converter={StaticResource WidthToColumnsConverter}, ConverterParameter=336}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <materialDesign:Card Height="Auto" Margin="8" HorizontalAlignment="Stretch">
                                                <Grid Margin="12">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <TextBlock Text="{Binding LogicalChannelNo, StringFormat='通道 {0}'}" FontWeight="Bold" Margin="0,0,0,8"/>
                                                    
                                                    <Border Grid.Row="1" Background="#1E1E1E" Margin="0,0,0,12" CornerRadius="4" ClipToBounds="True"
                                                            Height="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth, Converter={StaticResource AspectRatioConverter}, ConverterParameter=0.5625}">
                                                        <Grid>
                                                            <!-- 占位画面 (未推流且未预览时显示) -->
                                                            <Grid Background="#151515" Visibility="{Binding IsVideoViewVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                <!-- 视频首帧缩略图 -->
                                                                <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" 
                                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                
                                                                <!-- 覆盖半透明遮罩与文字图标 -->
                                                                <Grid Background="#CC151515" Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <materialDesign:PackIcon Kind="VideoOff" Width="28" Height="28" Foreground="#88FFFFFF" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding PlaceholderText}" Foreground="#D0FFFFFF" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                
                                                                <!-- 无缩略图时的默认占位画面 -->
                                                                <Grid Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <materialDesign:PackIcon Kind="VideoOff" Width="28" Height="28" Foreground="#444444" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding PlaceholderText}" Foreground="#666666" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>

                                                            <!-- 实际视频播放控件 -->
                                                            <vlc:VideoView MediaPlayer="{Binding MediaPlayer}" Visibility="{Binding IsVideoViewVisible, Converter={StaticResource BooleanToHiddenVisibilityConverter}}" Loaded="VideoView_Loaded" IsVisibleChanged="VideoView_IsVisibleChanged" />
                                                        </Grid>
                                                    </Border>
                                                    
                                                    <StackPanel Grid.Row="2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding VideoFilePath}" IsReadOnly="True" ToolTip="{Binding VideoFilePath}" materialDesign:HintAssist.Hint="选择视频或 H.264..."/>
                                                            <Button Grid.Column="1" Content="..." Command="{Binding SelectVideoFileCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,0" Height="24" Margin="8,0,0,0"/>
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <ToggleButton IsChecked="{Binding IsConstantFramerate}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="启用匀速推送"/>
                                                            <TextBlock Text="匀速" VerticalAlignment="Center" Margin="4,0,16,0"/>
                                                            
                                                            <TextBox Text="{Binding TargetFps}" Width="40" VerticalAlignment="Center" materialDesign:HintAssist.Hint="FPS" IsReadOnly="{Binding IsConstantFramerate}"/>
                                                            <TextBlock Text="FPS" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                            <Button Content="{Binding PreviewButtonText}" 
                                                                    Command="{Binding TogglePreviewCommand}" 
                                                                    Visibility="{Binding IsPreviewBtnVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                    Height="24" Padding="8,0" Margin="16,0,0,0" VerticalAlignment="Center"/>

                                                            <!-- 静音控制按钮 -->
                                                            <Button Command="{Binding ToggleMuteCommand}" 
                                                                    Visibility="{Binding IsVideoViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                                    Width="24" Height="24" Margin="16,0,0,0" Padding="0" VerticalAlignment="Center" ToolTip="声音控制">
                                                                <materialDesign:PackIcon Kind="{Binding MuteIcon}" Width="18" Height="18"/>
                                                            </Button>
                                                        </StackPanel>
                                                        <TextBox Text="{Binding StatusText}" Foreground="Gray" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" MaxHeight="50" VerticalScrollBarVisibility="Auto" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                                                    </StackPanel>
                                                </Grid>
                                            </materialDesign:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </materialDesign:Card>
        </Grid>
        </Grid> <!-- Closes Normal Main Content Wrapper -->

        <!-- Analyzer View -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Margin="8">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Opacity" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAnalyzerVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,8">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="输入 JT808 16进制原始报文" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding AnalyzerInputHex}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="80" Margin="0,0,16,0" FontFamily="Consolas" />
                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Width="120">
                        <Button Command="{Binding AnalyzeMessageCommand}" Content="解析报文" Height="40" Style="{StaticResource MaterialDesignRaisedButton}" Foreground="White" Cursor="Hand" Margin="0,0,0,8" />
                        <ComboBox SelectedIndex="{Binding AnalyzerMode}" materialDesign:HintAssist.Hint="解析模式">
                            <ComboBoxItem Content="表格解析模式" />
                            <ComboBoxItem Content="树状解析模式" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
            
            <materialDesign:Card Grid.Row="1">
                <Grid>
                    <TreeView x:Name="AnalyzerTreeView" PreviewKeyDown="AnalyzerTreeView_PreviewKeyDown" ItemsSource="{Binding AnalyzerResultTree}" Margin="8" FontFamily="Consolas" FontSize="14">
                        <TreeView.Style>
                            <Style TargetType="TreeView" BasedOn="{StaticResource MaterialDesignTreeView}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnalyzerMode}" Value="1">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Style>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource MaterialDesignBody}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    
                    <DataGrid ItemsSource="{Binding AnalyzerResultTable}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" Margin="8" FontFamily="Consolas" FontSize="14" HeadersVisibility="Column" SelectionUnit="Cell" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnalyzerMode}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="字段" Binding="{Binding Field}" CanUserSort="False" />
                            <DataGridTextColumn Header="报文原数据" Binding="{Binding HexData}" SortMemberPath="Index" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" FontWeight="Bold" />
                            <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" SortMemberPath="Index" />
                            <DataGridTextColumn Header="起始位" Binding="{Binding OffsetStr}" SortMemberPath="Index" />
                            <DataGridTextColumn Header="数据长度" Binding="{Binding LengthStr}" SortMemberPath="Index" />
                            <DataGridTextColumn Header="分析结果" Binding="{Binding Result}" Width="*" SortMemberPath="Index" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>

        </Grid>
    </Grid>
</Window>
