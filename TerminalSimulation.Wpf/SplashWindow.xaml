<Window x:Class="TerminalSimulation.Wpf.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="车载定位终端模拟系统"
        Width="960" Height="540"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
    <Border CornerRadius="18"
            ClipToBounds="True"
            BorderBrush="#55FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32"
                              ShadowDepth="10"
                              Opacity="0.42"
                              Color="#101828"/>
        </Border.Effect>

        <Grid>
            <Grid.Background>
                <ImageBrush x:Name="SplashBackground" Stretch="UniformToFill"/>
            </Grid.Background>

            <!-- Keep text readable on both bright and dark random images. -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                        <GradientStop Color="#A90B1424" Offset="0"/>
                        <GradientStop Color="#350B1424" Offset="0.52"/>
                        <GradientStop Color="#C40B1424" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Margin="38,32,38,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="车载定位终端模拟系统"
                               Foreground="White"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="34"
                               FontWeight="Bold"
                               Effect="{DynamicResource TitleShadowEffect}"/>
                    <TextBlock Text="Vehicle Positioning Terminal Simulation"
                               Foreground="#DDE7F4"
                               FontFamily="Segoe UI"
                               FontSize="15"
                               Margin="2,6,0,22"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="LoadingText"
                                       Text="正在初始化应用组件…"
                                       Foreground="White"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <ProgressBar Width="300" Height="3"
                                         HorizontalAlignment="Left"
                                         Margin="0,10,0,0"
                                         IsIndeterminate="True"
                                         Foreground="#72A7FF"
                                         Background="#35FFFFFF"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">
                            <TextBlock Text="WPF DESKTOP"
                                       Foreground="#BFD0E6"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"/>
                            <TextBlock x:Name="VersionText"
                                       Foreground="White"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

    <Window.Resources>
        <DropShadowEffect x:Key="TitleShadowEffect"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Opacity="0.65"
                          Color="#000000"/>
    </Window.Resources>
</Window>
